{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-agent-os.local/contracts/body_plan.v0.schema.json",
  "title": "Agent OS body_plan.v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "organism_id",
    "organism_name",
    "body_plan_id",
    "body_plan_version",
    "compatible_contracts",
    "organs"
  ],
  "properties": {
    "schema_version": {
      "const": "body_plan.v0"
    },
    "organism_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "organism_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "agency_profile_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "body_plan_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "body_plan_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "compatible_contracts": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.-]*\\.v[0-9]+$"
      }
    },
    "organs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organ_id",
          "role"
        ],
        "properties": {
          "organ_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "driver_manifest_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            },
            "default": []
          }
        }
      }
    }
  }
}
