{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-agent-os.local/contracts/vrm_model_telemetry_consumer_routes.v0.schema.json",
  "title": "VRM Model Telemetry Consumer Routes v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "contract_ref",
    "id",
    "purpose",
    "implementation_readme",
    "organ_readme",
    "result_contract_ref",
    "result_authority_file",
    "result_package_files",
    "intended_readers",
    "global_boundaries",
    "routes",
    "stop_conditions",
    "consumer_guidance"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": "vrm_model_telemetry_consumer_routes.v0"
    },
    "contract_ref": {
      "const": "contracts/vrm_model_telemetry_consumer_routes/vrm_model_telemetry_consumer_routes.v0.schema.json"
    },
    "id": {
      "const": "vrm-model-telemetry-consumer-routes"
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "implementation_readme": {
      "type": "string",
      "pattern": "^runtime/vrm-model-telemetry/README\\.md$"
    },
    "organ_readme": {
      "type": "string",
      "pattern": "^organs/expression/vrm-model-telemetry/README\\.md$"
    },
    "result_contract_ref": {
      "const": "contracts/vrm_model_telemetry/vrm_model_telemetry.v0.schema.json"
    },
    "result_authority_file": {
      "const": "vrm_model_telemetry_summary.json"
    },
    "result_package_files": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "contains": {
        "const": "vrm_model_telemetry_summary.json"
      }
    },
    "intended_readers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "human_operator",
          "thought_core",
          "diagnostics",
          "status_store",
          "event_journal",
          "review_agent",
          "self_mirror_review"
        ]
      },
      "contains": {
        "const": "thought_core"
      }
    },
    "global_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_state_readback_only",
        "command_authority",
        "runtime_execution_authority",
        "self_mirror_authority",
        "expression_visible_pass_authority",
        "semantic_expression_authority",
        "roi_or_threshold_authority",
        "physical_display_proof",
        "home_assistant_action",
        "provider_call",
        "microphone_or_camera_input",
        "raw_model_asset_shared",
        "raw_media_shared",
        "raw_path_shared",
        "browser_storage_shared",
        "provider_payload_shared",
        "raw_bvh_shared",
        "raw_transform_trace_shared",
        "full_skeleton_shared"
      ],
      "properties": {
        "model_state_readback_only": {
          "const": true
        },
        "command_authority": {
          "const": false
        },
        "runtime_execution_authority": {
          "const": false
        },
        "self_mirror_authority": {
          "const": false
        },
        "expression_visible_pass_authority": {
          "const": false
        },
        "semantic_expression_authority": {
          "const": false
        },
        "roi_or_threshold_authority": {
          "const": false
        },
        "physical_display_proof": {
          "const": false
        },
        "home_assistant_action": {
          "const": false
        },
        "provider_call": {
          "const": false
        },
        "microphone_or_camera_input": {
          "const": false
        },
        "raw_model_asset_shared": {
          "const": false
        },
        "raw_media_shared": {
          "const": false
        },
        "raw_path_shared": {
          "const": false
        },
        "browser_storage_shared": {
          "const": false
        },
        "provider_payload_shared": {
          "const": false
        },
        "raw_bvh_shared": {
          "const": false
        },
        "raw_transform_trace_shared": {
          "const": false
        },
        "full_skeleton_shared": {
          "const": false
        }
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "route_id",
          "mode",
          "telemetry_focus",
          "command_template",
          "proof_layer",
          "preconditions",
          "accept_result",
          "does_not_prove"
        ],
        "properties": {
          "route_id": {
            "type": "string",
            "pattern": "^vrm_model_telemetry\\.(source_static|runtime)\\.[a-z0-9_]+$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "SourceStatic",
              "RuntimeSummary"
            ]
          },
          "telemetry_focus": {
            "type": "string",
            "enum": [
              "profile_handoff",
              "expression_weights",
              "morph_delta_buckets",
              "rig_track_buckets",
              "bone_basis_tracks"
            ]
          },
          "command_template": {
            "type": "string",
            "minLength": 1
          },
          "proof_layer": {
            "type": "string",
            "enum": [
              "source_docs_contract_module_scaffold",
              "runtime_model_state_telemetry_summary_only"
            ]
          },
          "preconditions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "accept_result": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "does_not_prove": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9_./-]+$"
            }
          }
        }
      }
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "consumer_guidance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "thought_core",
        "diagnostics",
        "human_operator",
        "self_mirror_review"
      ],
      "properties": {
        "thought_core": {
          "type": "string",
          "minLength": 1
        },
        "diagnostics": {
          "type": "string",
          "minLength": 1
        },
        "human_operator": {
          "type": "string",
          "minLength": 1
        },
        "self_mirror_review": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
