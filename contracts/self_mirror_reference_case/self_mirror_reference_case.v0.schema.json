{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-agent-os.local/contracts/self_mirror_reference_case.v0.schema.json",
  "title": "Self Mirror Reference Case v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reference_case_id",
    "scenario_id",
    "scenario_key",
    "trigger",
    "created_at",
    "proof_layer",
    "run_refs",
    "metric_summary_ref",
    "roi_set",
    "time_windows",
    "pretrigger_metrics",
    "active_window_metrics",
    "human_observation_labels",
    "expected_result",
    "expected_reason_codes",
    "confidence",
    "redaction",
    "retention",
    "does_not_prove"
  ],
  "properties": {
    "schema_version": { "const": "self_mirror_reference_case.v0" },
    "reference_case_id": { "type": "string", "minLength": 1 },
    "scenario_id": { "type": "string", "minLength": 1 },
    "scenario_key": { "type": "string", "minLength": 1 },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "utterance_class", "raw_utterance_included"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "utterance_class": { "type": "string", "minLength": 1 },
        "trigger_at_ms": { "type": "integer", "minimum": 0 },
        "raw_utterance_included": { "const": false }
      }
    },
    "created_at": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string" },
    "profile_version": { "type": "string" },
    "proof_layer": { "type": "string", "minLength": 1 },
    "run_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "turn_id",
        "motion_requested_event_id",
        "motion_event_id",
        "stimulus_id",
        "stimulus_instance_id",
        "runtime_result_id",
        "runtime_status",
        "runtime_reason_code"
      ],
      "properties": {
        "turn_id": { "type": "string", "minLength": 1 },
        "motion_requested_event_id": { "type": "string", "minLength": 1 },
        "motion_event_id": { "type": "string", "minLength": 1 },
        "stimulus_id": { "type": "string", "minLength": 1 },
        "stimulus_instance_id": { "type": "string", "minLength": 1 },
        "runtime_result_id": { "type": "string", "minLength": 1 },
        "runtime_status": { "type": "string", "minLength": 1 },
        "runtime_reason_code": { "type": "string", "minLength": 1 }
      }
    },
    "metric_summary_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "summary_id", "analysis_run_id", "artifact_label", "local_path_included"],
      "properties": {
        "schema_version": { "const": "self_mirror_metric_summary.v0" },
        "summary_id": { "type": "string", "minLength": 1 },
        "analysis_run_id": { "type": "string", "minLength": 1 },
        "artifact_label": { "type": "string", "minLength": 1 },
        "local_path_included": { "const": false }
      }
    },
    "roi_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_roi_ids", "guard_roi_ids", "coordinate_system"],
      "properties": {
        "expected_roi_ids": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "guard_roi_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "coordinate_system": { "type": "string", "minLength": 1 }
      }
    },
    "time_windows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pretrigger", "active"],
      "properties": {
        "pretrigger": { "$ref": "#/$defs/time_window" },
        "active": { "$ref": "#/$defs/time_window" },
        "release": { "$ref": "#/$defs/time_window" },
        "settle": { "$ref": "#/$defs/time_window" }
      }
    },
    "pretrigger_metrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/roi_metric" }
    },
    "active_window_metrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/roi_metric" }
    },
    "release_window_metrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/roi_metric" }
    },
    "settle_window_metrics": {
      "type": "array",
      "items": { "$ref": "#/$defs/roi_metric" }
    },
    "human_observation_labels": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_quiet",
        "visible_motion_after_trigger",
        "moved_parts",
        "motion_quality_label",
        "false_positive_seen",
        "false_positive_categories",
        "observation_confidence",
        "raw_freeform_text_included"
      ],
      "properties": {
        "baseline_quiet": { "enum": ["yes", "no", "unclear", "not_collected"] },
        "visible_motion_after_trigger": { "enum": ["yes", "no", "unclear", "not_collected"] },
        "moved_parts": {
          "type": "array",
          "items": {
            "enum": ["whole_body", "torso", "left_arm", "right_arm", "head_face", "unclear", "not_collected"]
          }
        },
        "motion_quality_label": { "enum": ["dance_like", "small_twitch", "flicker", "unclear", "not_collected"] },
        "false_positive_seen": { "enum": ["yes", "no", "unclear", "not_collected"] },
        "false_positive_categories": {
          "type": "array",
          "items": {
            "enum": ["ui_panel", "loading_animation", "layout_shift", "camera_jump", "hud_motion", "unknown", "not_collected"]
          }
        },
        "observation_confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "raw_freeform_text_included": { "const": false }
      }
    },
    "expected_result": { "enum": ["pass", "fail", "unclear"] },
    "expected_reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "redaction": { "$ref": "#/$defs/redaction" },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retention_class", "raw_artifact_retained", "durable_memory_by_default"],
      "properties": {
        "retention_class": { "const": "calibration_summary" },
        "raw_artifact_retained": { "const": false },
        "durable_memory_by_default": { "const": false }
      }
    },
    "does_not_prove": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "contains": { "const": "not_raw_media_proof" }
    }
  },
  "$defs": {
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start_ms", "end_ms"],
      "properties": {
        "start_ms": { "type": "integer", "minimum": 0 },
        "end_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "roi_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "roi_id",
        "sample_count",
        "movement_score",
        "changed_ratio",
        "confidence",
        "expected_for_pass",
        "counts_as_avatar_motion",
        "raw_frame_included",
        "raw_screenshot_included"
      ],
      "properties": {
        "roi_id": { "type": "string", "minLength": 1 },
        "sample_count": { "type": "integer", "minimum": 0 },
        "movement_score": { "type": "number", "minimum": 0 },
        "changed_ratio": { "type": "number", "minimum": 0 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "expected_for_pass": { "type": "boolean" },
        "counts_as_avatar_motion": { "type": "boolean" },
        "pass_label": { "type": "string" },
        "raw_frame_included": { "const": false },
        "raw_screenshot_included": { "const": false }
      }
    },
    "redaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_frame_included",
        "raw_screenshot_included",
        "raw_video_included",
        "raw_audio_included",
        "raw_transcript_included",
        "provider_payload_included",
        "local_path_included",
        "secret_included",
        "device_entity_id_included",
        "raw_log_included"
      ],
      "properties": {
        "raw_frame_included": { "const": false },
        "raw_screenshot_included": { "const": false },
        "raw_video_included": { "const": false },
        "raw_audio_included": { "const": false },
        "raw_transcript_included": { "const": false },
        "provider_payload_included": { "const": false },
        "local_path_included": { "const": false },
        "secret_included": { "const": false },
        "device_entity_id_included": { "const": false },
        "raw_log_included": { "const": false }
      }
    }
  }
}
