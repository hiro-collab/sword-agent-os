          },
          "source_kind": {
            "const": "user_speech_candidate"
          },
          "speaker_role": {
            "const": "user_candidate"
          },
          "candidate_id": {
            "$ref": "#/$defs/private_live_candidate_id"
          },
          "recognition_summary": {
            "properties": {
              "recognition_summary_ref": {
                "$ref": "#/$defs/private_live_recognition_summary_ref"
              }
            }
          },
          "text_publication": {
            "properties": {
              "text_publication_policy": {
                "const": "text_redacted_or_absent"
              },
              "text_provenance_class": {
                "const": "redacted_or_absent"
              },
              "expected_sample_text": {
                "type": "null"
              },
              "recognized_text": {
                "type": "null"
              },
              "content_match_text": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "allOf": [
          {
            "required": [
              "proof_layer"
            ],
            "properties": {
              "proof_layer": {
                "const": "private_live_input_gate_decision"
              }
            }
          },
          {
            "required": [
              "acceptance_decision"
            ],
            "properties": {
              "acceptance_decision": {
                "properties": {
                  "acceptance_status": {
                    "const": "accepted_user_speech_candidate"
                  }
                }
              }
            }
          }
        ]
      },
      "then": {
        "properties": {
          "self_output_context": {
            "properties": {
              "self_output_correlation_class": {
                "const": "not_self_output"
              },
              "session_join_class": {
                "const": "current_active_session_explicitly_excluded"
              },
              "bubble_or_tts_as_user_speech_authority": {
                "const": false
              }
            }
          },
          "input_gate": {
            "properties": {
              "input_gate_decision_owner": {
                "const": "ai_talk_core_input_gate"
              },
              "input_gate_decision_class": {
                "const": "accepted_user_speech_candidate"
              },
              "normal_turn_block_reason": {
                "type": "null"
              }
            }
          },
          "acceptance_decision": {
            "properties": {
              "acceptance_status": {
                "const": "accepted_user_speech_candidate"
              },
              "may_materialize_thought_core_turninput": {
                "const": true
              },
              "private_text_handoff_required": {
                "const": true
              },
              "shared_artifact_contains_text": {
                "const": false
              }
            }
          },
          "runtime_session_join": {
            "properties": {
              "near_end_evidence": {
                "properties": {
                  "evidence_class": {
                    "const": "bounded_processed_near_end_candidate"
                  },
                  "window_ms": {
                    "minimum": 100,
                    "maximum": 5000
                  },
                  "packet_count": {
                    "minimum": 1,
                    "maximum": 500
                  },
                  "processed_byte_count": {
                    "minimum": 320,
                    "maximum": 160000
                  },
                  "frame_bytes": {
                    "const": 320
                  },
                  "storage_class": {
                    "const": "in_memory_ephemeral"
                  },
                  "aec_or_vad_turn_input_authority": {
                    "const": false
                  }
                }
              },
              "system_speech_session_join": {
                "properties": {
                  "observed_system_speech_session_id": {
                    "$ref": "#/$defs/system_speech_session_ref"
                  },
                  "observed_generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "active_system_speech_session_id": {
                    "$ref": "#/$defs/system_speech_session_ref"
                  },
                  "active_generation": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "playback_event_ref": {
                    "$ref": "#/$defs/playback_event_ref"
                  },
                  "self_output_observation_ref": {
                    "$ref": "#/$defs/self_output_observation_ref"
                  },
                  "self_output_observation_schema_version": {
                    "const": "audio_self_output_observation.v0"
                  },
                  "session_join_status": {
                    "const": "current_match"
                  },
                  "post_compare_session_status": {
                    "const": "current_unchanged"
                  },
                  "self_output_correlation_class": {
                    "const": "not_self_output"
                  },
                  "active_session_exclusion_status": {
                    "const": "explicitly_excluded_from_candidate"
                  },
                  "cooldown_status": {
                    "const": "clear"
                  },
                  "opaque_refs_non_dereferenceable": {
                    "const": true
                  }
                }
              },
              "one_use_gate": {
                "properties": {
                  "decision_owner": {
                    "const": "ai_talk_core_input_gate"
                  },
                  "candidate_identity_compare_status": {
                    "const": "matched"
                  },
                  "session_identity_compare_status": {
                    "const": "matched"
                  },
                  "generation_compare_status": {
                    "const": "matched"
                  },
                  "candidate_use_state": {
                    "const": "unused"
                  },
                  "compare_and_release_status": {
                    "const": "succeeded"
                  },
                  "one_use_consume_status": {
                    "const": "consumed"
                  },
                  "acceptance_status": {
                    "const": "accepted_user_speech_candidate"
                  },
                  "may_materialize_thought_core_turninput": {
                    "const": true
                  },
                  "turninput_materialization_limit": {
                    "const": 1
                  }
                }
              }
            }
          },
          "post_decision_audit": {
            "properties": {
              "serialized_contract_role": {
                "const": "post_decision_audit_only"
              },
              "process_local_capability_owner": {
                "const": "ai_talk_core_input_gate"
              },
              "materialization_executor": {
                "const": "later_ai_talk_core_process_local_code"
              },
              "process_local_one_use_capability_serialized": {
                "const": false
              },
              "capability_mint_authority": {
                "const": false
              },
              "capability_grant_authority": {
                "const": false
              },
              "capability_transport_authority": {
                "const": false
              },
              "internal_atomic_compare_completed": {
                "const": true
              },
              "output_status": {
                "const": "eligible_for_later_process_local_materialization"
              },
              "may_materialize_thought_core_turninput": {
                "const": true
              },
              "thought_core_turninput_materialized": {
                "const": false
              },
              "thought_core_turninput_count": {
                "const": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "candidate_id": {
      "type": "string",
      "pattern": "^ausc_[A-Za-z0-9_.:-]+$",
      "maxLength": 120
    },
    "private_live_candidate_id": {
      "type": "string",
      "pattern": "^ausc_live:cid_[a-f0-9]{32}$",
      "maxLength": 46
    },
    "private_live_recognition_summary_ref": {
      "type": "string",
      "pattern": "^user-speech-candidate-summary:rsc_[a-f0-9]{32}$",
      "maxLength": 66
    },
    "source_label": {
      "type": "string",
      "pattern": "^(voice\\.local_sample_[0-9]{3}|speech\\.user_candidate_[0-9]{3})$",
      "maxLength": 80
    },
    "opaque_ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]*:[A-Za-z0-9_.:-]+$",
      "maxLength": 160
    },
    "nullable_opaque_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/opaque_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "system_speech_session_ref": {
      "type": "string",
      "pattern": "^system-speech-session:sss_[a-f0-9]{32}$",
      "maxLength": 58
    },
    "playback_event_ref": {
      "type": "string",
      "pattern": "^playback-event:pe_[a-f0-9]{32}$",
      "maxLength": 50
    },
    "self_output_observation_ref": {
      "type": "string",
      "pattern": "^self-output-observation:aso_[a-f0-9]{32}$",
      "maxLength": 65
    },
    "nullable_system_speech_session_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/system_speech_session_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_playback_event_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/playback_event_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_self_output_observation_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/self_output_observation_ref"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
