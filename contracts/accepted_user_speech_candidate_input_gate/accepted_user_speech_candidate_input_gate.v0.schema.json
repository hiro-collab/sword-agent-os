            "session_identity_compare_status",
            "generation_compare_status",
            "candidate_use_state",
            "compare_and_release_status",
            "one_use_consume_status",
            "acceptance_status",
            "may_materialize_thought_core_turninput",
            "turninput_materialization_limit"
