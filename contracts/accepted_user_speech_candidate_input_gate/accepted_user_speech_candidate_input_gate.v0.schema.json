            "generation_compare_status": {
              "type": "string",
              "enum": [
                "matched",
                "mismatch",
                "stale",
                "missing",
                "not_checked"
              ]
            },
            "candidate_use_state": {
              "type": "string",
              "enum": [
                "unused",
                "duplicate"
              ]
            },
            "compare_and_release_status": {
              "type": "string",
              "enum": [
                "succeeded",
                "failed",
                "not_attempted"
              ]
            },
            "one_use_consume_status": {
              "type": "string",
              "enum": [
                "consumed",
                "duplicate",
                "failed",
                "not_attempted"
              ]
            },
            "acceptance_status": {
              "type": "string",
              "enum": [
                "accepted_user_speech_candidate",
                "blocked_session_join_missing",
                "blocked_session_join_mismatch",
                "blocked_session_join_stale",
                "blocked_active_system_speech_session",
                "blocked_self_output_cooldown",
                "blocked_duplicate_candidate",
                "blocked_compare_and_release_failed",
                "blocked_session_join_toctou"
              ]
            },
            "may_materialize_thought_core_turninput": {
              "type": "boolean"
            },
            "turninput_materialization_limit": {
              "const": 1
            }
          }
        }
