            "self_output",
            "ambiguous_speaker_or_route",
            "low_confidence",
            "redaction_only_summary",
            "session_join_missing",
            "session_join_mismatch",
            "session_join_stale",
            "active_system_speech_session",
            "self_output_cooldown_active",
            "duplicate_candidate",
            "compare_and_release_failed",
            "session_join_changed_after_check",
