    "candidate_id",
    "generated_at",
    "proof_layer",
    "route_id",
    "candidate_route",
    "source_kind",
    "speaker_role",
    "recognition_summary",
    "text_publication",
    "self_output_context",
    "input_gate",
    "acceptance_decision",
    "redaction_guards",
    "non_claims",
    "raw_private_publication_flags"
