{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-agent-os.local/contracts/driver_manifest.v0.schema.json",
  "title": "Agent OS driver_manifest.v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "body_plan_id",
    "drivers"
  ],
  "properties": {
    "schema_version": {
      "const": "driver_manifest.v0"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "body_plan_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "drivers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "driver_id",
          "driver_kind",
          "organ_id"
        ],
        "properties": {
          "driver_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "driver_kind": {
            "type": "string",
            "enum": [
              "real",
              "dummy",
              "compat_adapter"
            ]
          },
          "organ_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "instance_policy": {
            "type": "string",
            "enum": [
              "single",
              "multiple"
            ],
            "default": "single"
          },
          "provides_actions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/action"
            },
            "default": []
          },
          "status_keys": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.:-]*$"
            },
            "default": []
          }
        }
      }
    }
  },
  "$defs": {
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action_id",
        "risk_class",
        "parameter_schema"
      ],
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        },
        "risk_class": {
          "type": "string",
          "enum": [
            "internal",
            "reversible_external",
            "sensitive_external",
            "restricted"
          ]
        },
        "parameter_schema": {
          "type": "object"
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        },
        "requires_explicit_permission": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
