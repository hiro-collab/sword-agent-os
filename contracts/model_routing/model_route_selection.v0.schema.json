{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-agent-os.local/contracts/model_routing/model_route_selection.v0.schema.json",
  "title": "Agent OS model_route_selection.v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "selection_id",
    "task_class",
    "task_profile_id",
    "owner_module",
    "input_kind",
    "output_kind",
    "selected_route",
    "selected_model_route_id",
    "provider_allowed",
    "provider_status",
    "applied_modifiers",
    "suppressed_modifiers",
    "route_reason_codes",
    "fallback_policy",
    "fallback_reason_code",
    "authority_ceiling",
    "proof_authority_allowed",
    "redaction_profile",
    "cache_refs",
    "evidence_refs",
    "latency_bucket",
    "cost_bucket",
    "non_claims",
    "does_not_prove",
    "summary_safety"
  ],
  "properties": {
    "schema_version": {
      "const": "model_route_selection.v0"
    },
    "selection_id": {
      "type": "string",
      "pattern": "^model_sel_[A-Za-z0-9_.:-]+$"
    },
    "task_class": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]*$",
      "maxLength": 120
    },
    "task_profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]*$",
      "maxLength": 120
    },
    "owner_module": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.-]*$"
    },
    "input_kind": {
      "type": "string"
    },
    "output_kind": {
      "type": "string"
    },
    "selected_route": {
      "type": "string",
      "enum": [
        "no_llm",
        "conversation",
        "classifier_advisory",
        "review_advisory",
        "human_review",
        "local_fallback",
        "fail_closed"
      ]
    },
    "selected_model_route_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]*$",
      "maxLength": 120
    },
    "provider_allowed": {
      "type": "boolean"
    },
    "provider_status": {
      "type": "string",
      "enum": [
        "not_applicable",
        "disabled",
        "enabled",
        "unavailable",
        "held"
      ]
    },
    "applied_modifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "task_profile.v0.schema.json#/$defs/runtime_modifier"
      }
    },
    "suppressed_modifiers": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "task_profile.v0.schema.json#/$defs/runtime_modifier"
      }
    },
    "route_reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]*$",
        "maxLength": 120
      }
    },
    "fallback_policy": {
      "type": "string",
      "enum": [
        "local_fallback",
        "deterministic_hold",
        "human_review",
        "fail_closed"
      ]
    },
    "fallback_reason_code": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]*$",
      "maxLength": 120
    },
    "authority_ceiling": {
      "type": "string",
      "enum": [
        "none",
        "advisory_only",
        "human_or_policy_required",
        "blocked"
      ]
    },
    "proof_authority_allowed": {
      "const": false
    },
    "redaction_profile": {
      "type": "string",
      "enum": [
        "model_route_selection_summary_v0"
      ]
    },
    "cache_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]*$",
        "maxLength": 120
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]*$",
        "maxLength": 120
      }
    },
    "latency_bucket": {
      "type": "string",
      "enum": [
        "unknown",
        "low",
        "medium",
        "high",
        "held"
      ]
    },
    "cost_bucket": {
      "type": "string",
      "enum": [
        "unknown",
        "low",
        "medium",
        "high",
        "held"
      ]
    },
    "non_claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]*$",
        "maxLength": 120
      }
    },
    "does_not_prove": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_.:-]*$",
        "maxLength": 120
      }
    },
    "summary_safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_prompt_included",
        "raw_transcript_included",
        "provider_payload_included",
        "env_values_included",
        "secret_values_included",
        "private_path_included",
        "ha_or_device_detail_included",
        "raw_media_included",
        "final_authority_claimed",
        "live_or_git_authority_claimed"
      ],
      "properties": {
        "raw_prompt_included": {
          "const": false
        },
        "raw_transcript_included": {
          "const": false
        },
        "provider_payload_included": {
          "const": false
        },
        "env_values_included": {
          "const": false
        },
        "secret_values_included": {
          "const": false
        },
        "private_path_included": {
          "const": false
        },
        "ha_or_device_detail_included": {
          "const": false
        },
        "raw_media_included": {
          "const": false
        },
        "final_authority_claimed": {
          "const": false
        },
        "live_or_git_authority_claimed": {
          "const": false
        }
      }
    }
  }
}
