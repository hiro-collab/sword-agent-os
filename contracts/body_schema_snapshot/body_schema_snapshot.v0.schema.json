{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sword-agent-os.local/contracts/body_schema_snapshot.v0.schema.json",
  "title": "Body Schema Snapshot v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at",
    "organism_id",
    "organism_name",
    "body_plan_id",
    "body_plan_version",
    "agency_profile_id",
    "status_source",
    "organs"
  ],
  "properties": {
    "schema_version": {
      "const": "body_schema_snapshot.v0"
    },
    "generated_at": {
      "type": "string"
    },
    "organism_id": {
      "type": "string",
      "minLength": 1
    },
    "organism_name": {
      "type": "string",
      "minLength": 1
    },
    "body_plan_id": {
      "type": "string",
      "minLength": 1
    },
    "body_plan_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "agency_profile_id": {
      "type": ["string", "null"]
    },
    "status_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "present", "mapped_entries"],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "present": {
          "type": "boolean"
        },
        "mapped_entries": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "organs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organ_id",
          "role",
          "required",
          "driver_refs",
          "health",
          "freshness",
          "confidence",
          "services",
          "capabilities",
          "source_refs"
        ],
        "properties": {
          "organ_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]*$"
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "driver_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*$"
            }
          },
          "health": {
            "enum": ["ok", "warn", "degraded", "error", "blocked", "unknown"]
          },
          "freshness": {
            "enum": ["fresh", "stale", "missing", "unknown"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "services": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
