# Sword Agent OS central local env template.
# Copy to local/env/sword-agent-os.env and fill in real local values.
# Do not commit local/env/sword-agent-os.env.
#
# If the same key must differ per generated target, prefix it with the target id
# uppercased and with non-alphanumeric characters replaced by underscores.
# Example: AITUBER_KIT__OPENAI_API_KEY overrides OPENAI_API_KEY only for the
# aituber-kit target.

# Repository roots used by control-plane/sword-voice-agent/.env.
AI_TALK_CORE_ROOT=..\..\organs\speech-input\ai-talk-core
MEDIAPIPE_SWORD_SIGN_ROOT=..\..\organs\reflex\mediapipe-sword-sign
TTS_SERVICE_ROOT=..\..\organs\expression\tts-service
AVATAR_SERVICE_ROOT=..\..\organs\expression\avatar-service
SYSTEM_HOUSE_RENDERER_ROOT=..\..\organs\diagnostics\system-house-renderer

# Local bridge and Home Assistant tokens.
# Generate HOME_CONTROL_API_TOKEN with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HOME_CONTROL_CONFIG=config/home-control.yaml
HOME_CONTROL_API_TOKEN=REPLACE_WITH_RANDOM_BRIDGE_TOKEN
ENVIRONMENT_API_TOKEN=
HOME_ASSISTANT_TOKEN=REPLACE_WITH_HOME_ASSISTANT_LONG_LIVED_TOKEN
HOME_CONTROL_FAULT_MODE=0

# Thought Core local service.
THOUGHT_CORE_HOST=127.0.0.1
THOUGHT_CORE_PORT=18787
THOUGHT_CORE_BASE_URL=http://127.0.0.1:18787
NEXT_PUBLIC_THOUGHT_CORE_BASE_URL=http://127.0.0.1:18787
NEXT_PUBLIC_THOUGHT_CORE_SESSION_ID=aituber-kit
THOUGHT_CORE_TIMEOUT_S=60
THOUGHT_CORE_USER=local-user
THOUGHT_CORE_SESSION_ID=living_room_main
THOUGHT_CORE_LOCALE=ja-JP
THOUGHT_CORE_MAX_EXECUTE_ATTEMPTS=2
THOUGHT_CORE_TOOLS_ADAPTER=mock
THOUGHT_CORE_HOME_HTTP_TIMEOUT_S=3
THOUGHT_CORE_ROOM_LIGHT_WAIT_TIMEOUT_MS=1500

# Thought Core LLM adapter.
THOUGHT_CORE_LLM_ENABLED=true
THOUGHT_CORE_LLM_BASE_URL=https://api.openai.com/v1
THOUGHT_CORE_LLM_API_KEY=
THOUGHT_CORE_LLM_MODEL=gpt-4o-mini
THOUGHT_CORE_LLM_TIMEOUT_S=12
THOUGHT_CORE_LLM_MAX_CHARS=220

# OpenAI-compatible aliases used by some adapters.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Dify compatibility path. Projection Visual should prefer Thought Core unless
# you are intentionally testing Dify compatibility.
DIFY_BASE_URL=http://localhost:8080/v1
DIFY_URL=http://localhost:8080/v1
DIFY_API_KEY=
DIFY_USER=local-user
DIFY_RESPONSE_MODE=streaming
NEXT_PUBLIC_SELECT_AI_SERVICE=thought-core
NEXT_PUBLIC_PROJECTION_VISUAL_AI_SERVICE=thought-core
NEXT_PUBLIC_PROJECTION_VISUAL_FORCE_DIFY=
NEXT_PUBLIC_PROJECTION_VISUAL_CONTINUOUS_MIC=false

# AITuberKit display and voice.
NEXT_PUBLIC_SELECT_LANGUAGE=ja
NEXT_PUBLIC_CHARACTER_NAME=ニケちゃん
NEXT_PUBLIC_MODEL_TYPE=vrm
NEXT_PUBLIC_SELECTED_VRM_PATH=/vrm/Nutachisan.vrm
VOICEVOX_SERVER_URL=http://127.0.0.1:50021
NEXT_PUBLIC_VOICEVOX_SPEAKER=46
NEXT_PUBLIC_SPEECH_RECOGNITION_MODE=browser

# Environment and local services.
HOME_CONTROL_BRIDGE_URL=http://127.0.0.1:8787
HOME_ASSISTANT_BRIDGE_URL=http://127.0.0.1:8787
ENVIRONMENT_STATE_URL=http://127.0.0.1:8790/environment/current
AITUBER_MESSAGE_URL=
AI_TALK_CORE_INPUT_GATE_URL=http://127.0.0.1:8000/api/input-gate
AI_TALK_CORE_WEB_TOKEN=

# TTS service.
TTS_OUTPUT_STATUS_DIR=.cache\tts_service
TTS_SOURCE=http
TTS_HTTP_HOST=127.0.0.1
TTS_HTTP_PORT=8765
TTS_HTTP_CHUNK_MAX_CHARS=80
TTS_HTTP_CHUNK_URL=http://127.0.0.1:8765/api/tts/chunk
TTS_VOLUME_URL=http://127.0.0.1:8765/api/volume
TTS_VOLUME_PREVIEW_URL=http://127.0.0.1:8765/api/volume/preview
TTS_HTTP_TIMEOUT_S=0.75
TTS_ENGINE=windows-sapi
TTS_PLAYER=speaker
TTS_POLL_INTERVAL=1.0
TTS_VOICE_NAME=
TTS_RATE=0
TTS_VOLUME=100
TTS_APP_VOLUME=1.0
TTS_SERVICE_APP_VOLUME_FILE=.cache\tts_service\app_volume.json
TTS_OUTPUT_AUDIO_DIR=.cache\tts_service\audio_output
TTS_SERVICE_RUNTIME_STATUS_FILE=.cache\sword_voice_agent\runtime\tts_service.json
TTS_SERVICE_SHUTDOWN_TOKEN=
TTS_SERVICE_STATUS_DIR=.cache/tts_service
TTS_SERVICE_POLL_INTERVAL=1.0
TTS_SERVICE_SAPI_VOICE=
TTS_SERVICE_SAPI_RATE=0
TTS_SERVICE_SAPI_VOLUME=100

# Security and redaction toggles.
SWORD_VOICE_AGENT_AUTH_TOKEN=
SWORD_VOICE_AGENT_REDACT_STATUS=0
SWORD_VOICE_AGENT_MIN_CONFIDENCE=0.8
SWORD_VOICE_AGENT_ACTIVATION_DELAY=0.3
SWORD_VOICE_AGENT_RELEASE_DELAY=0.5
