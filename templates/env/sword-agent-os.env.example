# Sword Agent OS central local env template.
# このファイルを local/env/sword-agent-os.env にコピーして、実際のローカル値を入れます。
# local/env/sword-agent-os.env は秘密値を含むため Git に commit しません。
#
# この中央 env は標準ローカル構成の設定元です。render-env-files.ps1 がこの値を読み、
# control plane や各 organ の .env へ必要な値を生成します。通常は各 organ の .env を
# 直接編集せず、local/env/sword-agent-os.env を編集してから再生成します。
#
# NEXT_PUBLIC_ で始まる値はブラウザ側コードから見えます。provider secret、
# Home Assistant token、private API key は NEXT_PUBLIC_ に入れないでください。
#
# Field classification legend:
# - Required: always / llm / live-home / optional
# - Empty allowed: yes / no / when-unused
# - Secret: yes / no
# - Browser-visible: yes / no
# - Read by: launcher / control-plane / thought-core / home-assistant-server /
#   environment-state / aituber-kit / tts-service など
#
# 同じキーを出力先ごとに変えたい場合は、target id を大文字化し、英数字以外を
# underscore にした prefix を付けます。
# 例: AITUBER_KIT__OPENAI_API_KEY は aituber-kit 出力先だけの OPENAI_API_KEY です。
# よく使う prefix: CONTROL_PLANE__, THOUGHT_CORE__, HOME_ASSISTANT_SERVER__,
# TTS_SERVICE__, AITUBER_KIT__.

# Repository roots.
# Launch Manager / control plane が各 organ の checkout を探すためのパスです。
# 標準の配置で clone した場合は、通常このままで構いません。
# Required: always for assembled standard checkout
# Empty allowed: no
# Secret: no
# Browser-visible: no
# Read by: launcher, control-plane
AI_TALK_CORE_ROOT=..\..\organs\speech-input\ai-talk-core
MEDIAPIPE_SWORD_SIGN_ROOT=..\..\organs\reflex\mediapipe-sword-sign
TTS_SERVICE_ROOT=..\..\organs\expression\tts-service
AVATAR_SERVICE_ROOT=..\..\organs\expression\avatar-service
SYSTEM_HOUSE_RENDERER_ROOT=..\..\organs\diagnostics\system-house-renderer

# Local bridge and Home Assistant tokens.
# Required:
# - HOME_CONTROL_CONFIG: live-home
# - HOME_CONTROL_API_TOKEN: live-home / local bridge protection
# - ENVIRONMENT_API_TOKEN: optional; empty allowed in standard local setup
# - HOME_ASSISTANT_TOKEN: live-home
# Empty allowed:
# - ENVIRONMENT_API_TOKEN: yes
# - HOME_ASSISTANT_TOKEN: yes for no-live/mock, no for live Home Assistant
# Secret: yes for *_TOKEN values
# Browser-visible: no
# Read by: home-assistant-server, environment-state, thought-core
# HOME_CONTROL_CONFIG は家電名や Home Assistant entity を対応づけるローカル設定です。
# 外部の Home Assistant と連携する場合は、先に docs/home-assistant-setup.md を読みます。
# 既定の config/home-control.yaml は demo/default/template 用です。HA-visible CheckState proof
# には、ignored private full-schema config または reviewed clone-local equivalent を選びます。
# short/minimal action-only override は command/ack までは扱えても、expected-effect target、
# verification metadata、CheckTracking/CheckState による proof-ready context には不足します。
# render-env-files.ps1 -Force の後は、target fresh clone でその full-schema config を
# もう一度選び直してから read-only parity gate を通してください。
#
# HOME_CONTROL_API_TOKEN は、この OS 内の Home Assistant bridge API を保護する
# ローカル用 token です。Home Assistant の long-lived access token ではありません。
# 次のような乱数で作り、ここに貼ります。
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ENVIRONMENT_API_TOKEN は Environment State API 用のローカル token です。標準構成では
# 空欄のまま bridge token/fallback を使えます。Environment State だけを別 token で
# 守りたい場合は、HOME_CONTROL_API_TOKEN と同じ方法で別の乱数を作ります。
#
# HOME_ASSISTANT_TOKEN は Home Assistant 本体の long-lived access token です。
# 家電の状態確認と操作に使います。Home Assistant のユーザープロファイル/セキュリティ
# 画面で作成し、ここに貼ります。絶対に commit しないでください。
HOME_CONTROL_CONFIG=config/home-control.yaml
HOME_CONTROL_API_TOKEN=REPLACE_WITH_RANDOM_BRIDGE_TOKEN
ENVIRONMENT_API_TOKEN=
HOME_ASSISTANT_TOKEN=REPLACE_WITH_HOME_ASSISTANT_LONG_LIVED_TOKEN
# HOME_CONTROL_FAULT_MODE はテスト用の故障注入設定です。通常運用では 0 のままです。
HOME_CONTROL_FAULT_MODE=0

# Thought Core local service.
# Required: always
# Empty allowed: no for host/port/base URL; user/session ids are local labels
# Secret: no
# Browser-visible: yes only for NEXT_PUBLIC_THOUGHT_CORE_*
# Read by: thought-core, aituber-kit, control-plane
# Thought Core は、会話応答、道具の呼び出し、家電操作後の再確認などを判断する
# 「思考回路」サーバーです。host / port / base URL は Launcher が起動する
# ローカル Thought Core と合わせます。NEXT_PUBLIC 側の URL は AITuberKit など
# ブラウザ画面から接続するための URL です。
THOUGHT_CORE_HOST=127.0.0.1
THOUGHT_CORE_PORT=18787
THOUGHT_CORE_BASE_URL=http://127.0.0.1:18787
NEXT_PUBLIC_THOUGHT_CORE_BASE_URL=http://127.0.0.1:18787
# NEXT_PUBLIC_THOUGHT_CORE_SESSION_ID はブラウザ/表示側の session label です。
NEXT_PUBLIC_THOUGHT_CORE_SESSION_ID=aituber-kit
THOUGHT_CORE_TIMEOUT_S=60
# THOUGHT_CORE_USER / THOUGHT_CORE_SESSION_ID は会話や状態をつなぐための識別子です。
# provider credential ではありません。
THOUGHT_CORE_USER=local-user
THOUGHT_CORE_SESSION_ID=living_room_main
THOUGHT_CORE_LOCALE=ja-JP
# execute attempts や timeout は、家電操作と操作後確認の待ち時間に関係します。
# 遅い bridge / device を扱う場合だけ調整します。
THOUGHT_CORE_MAX_EXECUTE_ATTEMPTS=2
# 家電操作の実行先を切り替えます。
# mock: no-live / test mode。Thought Core は「テストモード」として応答し、
#       Home Assistant や実家電にはコマンドを送りません。
# home_control: local Home Control bridge 経由で Home Assistant / 実家電へ送ります。
#       HOME_CONTROL_API_TOKEN、HOME_ASSISTANT_TOKEN、home-control.yaml の設定が必要です。
#       中央 env を変更したら render-env-files.ps1 -Profile standard -Force を実行し、
#       関連サービスを再起動してください。
# 注意: bridge health が OK でも、この値が mock のままなら実家電には送りません。
THOUGHT_CORE_TOOLS_ADAPTER=mock
THOUGHT_CORE_HOME_HTTP_TIMEOUT_S=3
THOUGHT_CORE_ROOM_LIGHT_WAIT_TIMEOUT_MS=1500

# Thought Core LLM adapter.
# Required: llm
# Empty allowed: yes when THOUGHT_CORE_LLM_ENABLED=false
# Secret: yes for THOUGHT_CORE_LLM_API_KEY
# Browser-visible: no
# Read by: thought-core
# Thought Core が自然文応答を作るために OpenAI 互換 LLM を呼ぶ設定です。
# 通常は THOUGHT_CORE_LLM_API_KEY が主な LLM API key です。OpenAI を使う場合は
# OpenAI の project/API key を用意し、THOUGHT_CORE_LLM_BASE_URL は
# https://api.openai.com/v1 のままにします。mock/local 動作だけを確認する場合は
# THOUGHT_CORE_LLM_ENABLED=false にします。
THOUGHT_CORE_LLM_ENABLED=true
THOUGHT_CORE_LLM_BASE_URL=https://api.openai.com/v1
THOUGHT_CORE_LLM_API_KEY=
THOUGHT_CORE_LLM_MODEL=gpt-4o-mini
THOUGHT_CORE_LLM_TIMEOUT_S=12
THOUGHT_CORE_LLM_MAX_CHARS=220

# OpenAI-compatible aliases.
# Required: optional compatibility
# Empty allowed: yes when unused
# Secret: yes for OPENAI_API_KEY
# Browser-visible: no
# Read by: adapters that still use generic OPENAI_* values
# 一部 adapter / compatibility route が THOUGHT_CORE_LLM_* ではなく汎用 OPENAI_* を
# 読む場合があります。その場合に使う別名です。意図的に target-scoped override する
# 場合を除き、THOUGHT_CORE_LLM_* と矛盾しない値にします。
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# AITuberKit display and voice.
# Required: always for browser display; VOICEVOX is recommended for voice output
# Empty allowed: when the corresponding display/voice feature is unused
# Secret: no
# Browser-visible: yes for NEXT_PUBLIC_*; secret禁止
# Read by: aituber-kit
# ブラウザ上の avatar / Projection Visual / 言語 / 表示 asset / 音声出力の設定です。
# NEXT_PUBLIC_ が多いため、ここは secret 置き場ではなく表示設定として扱います。
NEXT_PUBLIC_SELECT_AI_SERVICE=thought-core
NEXT_PUBLIC_PROJECTION_VISUAL_AI_SERVICE=thought-core
NEXT_PUBLIC_PROJECTION_VISUAL_CONTINUOUS_MIC=false
NEXT_PUBLIC_SELECT_LANGUAGE=ja
NEXT_PUBLIC_CHARACTER_NAME=ニケちゃん
NEXT_PUBLIC_MODEL_TYPE=vrm
# NEXT_PUBLIC_SELECTED_VRM_PATH は AITuberKit の public asset 内のパスです。
# clean install では tracked sample の /vrm/nikechan_v1.vrm で確認できます。
# 手元のライセンス済み VRM を使う場合は public/vrm に置き、/vrm/<file>.vrm を書きます。
NEXT_PUBLIC_SELECTED_VRM_PATH=/vrm/nikechan_v1.vrm
# VOICEVOX_SERVER_URL はローカル VOICEVOX engine の URL です。先に VOICEVOX を
# 起動し、port を変えていなければこのまま使います。
VOICEVOX_SERVER_URL=http://127.0.0.1:50021
NEXT_PUBLIC_VOICEVOX_SPEAKER=46
NEXT_PUBLIC_SPEECH_RECOGNITION_MODE=browser

# Environment and local services.
# Required: always for standard local service wiring; some endpoints can be
# unavailable in no-live/mock checks
# Empty allowed: yes for optional AITUBER_MESSAGE_URL / AI_TALK_CORE_WEB_TOKEN
# Secret: AI_TALK_CORE_WEB_TOKEN is secret if enabled
# Browser-visible: no
# Read by: thought-core, aituber-kit, environment-state, control-plane
# 思考/表示の流れを、観測・家電操作・音声入力などのローカル service につなぐ URL です。
# - HOME_CONTROL_BRIDGE_URL / HOME_ASSISTANT_BRIDGE_URL: 家電状態と操作の bridge。
# - ENVIRONMENT_STATE_URL: HUD と Thought Core が読む現在の部屋/環境 snapshot。
# - AITUBER_MESSAGE_URL: 必要な場合だけ使う message injection endpoint。
# - AI_TALK_CORE_*: speech-input / input-gate の compatibility route。
HOME_CONTROL_BRIDGE_URL=http://127.0.0.1:8787
HOME_ASSISTANT_BRIDGE_URL=http://127.0.0.1:8787
ENVIRONMENT_STATE_URL=http://127.0.0.1:8790/environment/current
AITUBER_MESSAGE_URL=
AI_TALK_CORE_INPUT_GATE_URL=http://127.0.0.1:8000/api/input-gate
# AI_TALK_CORE_WEB_TOKEN は input-gate が browser/client token を要求する構成でだけ
# 使います。その auth layer を使わないローカル構成では空欄で構いません。
AI_TALK_CORE_WEB_TOKEN=

# TTS service.
# Required: optional/recommended for voice output
# Empty allowed: yes for optional voice name and shutdown token
# Secret: TTS_SERVICE_SHUTDOWN_TOKEN is secret if enabled
# Browser-visible: no
# Read by: tts-service, control-plane
# text chunk を音声や preview に変換する expression organ の設定です。HTTP 系は
# ローカル TTS API、SAPI 系は Windows SAPI fallback の声・速度・音量です。
TTS_OUTPUT_STATUS_DIR=.cache\tts_service
TTS_SOURCE=http
TTS_HTTP_HOST=127.0.0.1
TTS_HTTP_PORT=8765
TTS_HTTP_CHUNK_MAX_CHARS=80
TTS_HTTP_CHUNK_URL=http://127.0.0.1:8765/api/tts/chunk
TTS_VOLUME_URL=http://127.0.0.1:8765/api/volume
TTS_VOLUME_PREVIEW_URL=http://127.0.0.1:8765/api/volume/preview
TTS_HTTP_TIMEOUT_S=0.75
TTS_ENGINE=windows-sapi
TTS_PLAYER=speaker
TTS_POLL_INTERVAL=1.0
TTS_VOICE_NAME=
TTS_RATE=0
TTS_VOLUME=100
TTS_APP_VOLUME=1.0
TTS_SERVICE_APP_VOLUME_FILE=.cache\tts_service\app_volume.json
TTS_OUTPUT_AUDIO_DIR=.cache\tts_service\audio_output
TTS_SERVICE_RUNTIME_STATUS_FILE=.cache\sword_voice_agent\runtime\tts_service.json
TTS_SERVICE_SHUTDOWN_TOKEN=
TTS_SERVICE_STATUS_DIR=.cache/tts_service
TTS_SERVICE_POLL_INTERVAL=1.0
TTS_SERVICE_SAPI_VOICE=
TTS_SERVICE_SAPI_RATE=0
TTS_SERVICE_SAPI_VOLUME=100

# Security and redaction toggles.
# Required: optional protection/redaction
# Empty allowed: yes when protection route is disabled
# Secret: yes for SWORD_VOICE_AGENT_AUTH_TOKEN
# Browser-visible: no
# Read by: control-plane
# SWORD_VOICE_AGENT_AUTH_TOKEN は control-plane の保護 route 用の任意 local auth
# token です。有効にする場合は HOME_CONTROL_API_TOKEN と同じ方法で作ります。
# SWORD_VOICE_AGENT_REDACT_STATUS=1 にすると、表示面に出したくない status/debug
# detail を隠します。
SWORD_VOICE_AGENT_AUTH_TOKEN=
SWORD_VOICE_AGENT_REDACT_STATUS=0
SWORD_VOICE_AGENT_MIN_CONFIDENCE=0.8
SWORD_VOICE_AGENT_ACTIVATION_DELAY=0.3
SWORD_VOICE_AGENT_RELEASE_DELAY=0.5
