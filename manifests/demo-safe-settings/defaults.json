      "description": "Self Mirror method/scenario row. It proves nothing until an explicit browser route emits summary metrics.",
      "enabled": false,
      "restore_supported": false,
      "restore_required": false,
      "max_action_count": 0,
      "max_duration_sec": 60,
      "source_class": "projection_visual_starter_self_mirror_method",
