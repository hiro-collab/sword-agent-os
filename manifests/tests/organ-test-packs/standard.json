        },
        {
          "id": "display_runtime.projection_manual",
          "mode": "manual",
          "type": "manual_check",
          "instructions": "Confirm Display Runtime GUI status and TouchDesigner/projector behavior when hardware is available."
        }
      ]
    },
    {
      "organ_id": "system-house-renderer",
      "role": "diagnostics/topology-view",
      "service_ids": [],
      "capabilities": ["diagnostics_view", "topology_rendering"],
      "tests": [
        {
          "id": "system_house_renderer.checkout",
          "mode": "auto",
          "type": "path_exists",
          "path": "organs/diagnostics/system-house-renderer",
          "expect": "exists"
        },
        {
          "id": "system_house_renderer.diagnostics_view_capability",
          "mode": "auto",
          "type": "diagnostics_capability",
          "capability": "diagnostics_view",
